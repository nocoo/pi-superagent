{
  "name": "pi-superagent",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "description": "A proactive multi-task agent for one repository. The domain core of dsh-superagent, with the agent runtime replaced by Pi.",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "pi-superagent": "lib/cli.js"
  },
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "prompts"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && vitest run",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "commander": "^15.0.0",
    "proper-lockfile": "4.1.2",
    "typebox": "1.4.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  }
}
