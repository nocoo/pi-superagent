{
  "name": "pi-superagent",
  "version": "0.0.4",
  "private": true,
  "license": "MIT",
  "description": "A CLI-first general-purpose multi-task agent with persistent Pi coordination and a local management panel.",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "pi-superagent": "lib/cli.js"
  },
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "prompts",
    "web/dist"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build:cli": "tsc -p tsconfig.build.json",
    "build": "pnpm build:cli && vite build",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm build:cli && pnpm test:coverage",
    "dev": "pnpm build && node lib/cli.js web",
    "test:live": "pnpm build && node scripts/probe-system.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@nocoo/basalt": "^3.6.0",
    "commander": "^15.1.0",
    "proper-lockfile": "4.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typebox": "1.4.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.0",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "4.1.12",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "^8.3.5",
    "vitest": "4.1.12"
  }
}
